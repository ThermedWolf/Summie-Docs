{
  "appId": "com.summie.installer",
  "productName": "Summie Setup",
  "directories": {
    "output": "../dist-installer"
  },
  "extraMetadata": {
    "main": "installer/main-installer.js"
  },
  "files": [
    "installer/main-installer.js",
    "installer/preload-installer.js",
    "installer/installer.html",
    "installer/installer.css",
    "installer/installer.js",
    "installer/i18n.js"
  ],
  "extraResources": [
    {
      "from": "dist/win-unpacked",
      "to": "payload",
      "filter": ["**/*", "!**/piper-bin/**", "!**/*.so", "!**/*.so.*"]
    },
    {
      "from": "app/icon.png",
      "to": "app-icon.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "app/icon.png",
    "artifactName": "Summie-windows-x64-${version}-Setup.${ext}"
  },
  "portable": {
    "artifactName": "Summie-windows-x64-${version}-Setup.${ext}",
    "requestExecutionLevel": "user"
  },
  "publish": null,
  "forceCodeSigning": false,
  "compression": "store"
}
