{
  "name": "summie",
  "version": "4.2.0",
  "description": "Summie - Samenvattingen Maker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.summie.app",
    "productName": "Summie",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "sumd",
        "name": "Summie Document",
        "description": "Summie Document",
        "icon": "app/icon.png",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.png",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "installerIcon": "app/installer-icon.ico",
      "uninstallerIcon": "app/installer-icon.ico",
      "installerHeaderIcon": "app/installer-icon.ico",
      "uninstallDisplayName": "Summie",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "perMachine": false,
      "include": "installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "app/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeExtensions": ["sumd"],
            "CFBundleTypeName": "Summie Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner"
          }
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "app/icon.png",
      "category": "Office",
      "maintainer": "ThermedWolf",
      "description": "Summie - Samenvattingen Maker",
      "desktop": {
        "Name": "Summie",
        "Comment": "Samenvattingen Maker",
        "Categories": "Office;Education;",
        "Keywords": "summary;notes;education;"
      }
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.4"
  }
}