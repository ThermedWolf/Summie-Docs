{
  "name": "summie",
  "version": "4.3.0",
  "description": "Summie - Samenvattingen Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.summie.app",
    "productName": "Summie",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app/**/*"
    ],
    "publish": null,
    "fileAssociations": [
      {
        "ext": "sumd",
        "name": "Summie Document",
        "description": "Summie Document",
        "icon": "app/icon.png",
        "role": "Editor",
        "mimeType": "application/x-summie-sumd"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Summie-windows-x64-${version}.${ext}",
      "icon": "app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "installerIcon": "app/installer-icon.ico",
      "uninstallerIcon": "app/installer-icon.ico",
      "installerHeaderIcon": "app/installer-icon.ico",
      "uninstallDisplayName": "Summie",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "perMachine": false,
      "include": "installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Summie-mac-${arch}-${version}.${ext}",
      "icon": "app/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Summie-linux-${arch}.${ext}",
      "icon": "app/icon.png",
      "category": "Office",
      "maintainer": "ThermedWolf",
      "description": "Summie - Samenvattingen Maker",
      "desktop": {
        "Name": "Summie",
        "Comment": "Samenvattingen Maker",
        "Categories": "Office;Education;",
        "Keywords": "summary;notes;education;"
      }
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.13",
    "electron-log": "^5.4.4"
  }
}
